{
  "name": "skybook",
  "version": "1.0.0",
  "description": "SkyBook Flight Reservation System",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client\"",
    "client": "npm run dev --prefix client",
    "server": "npm start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "start": "concurrently -k -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "test": "npm test --prefix server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
